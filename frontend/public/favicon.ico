<svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="32" height="32" rx="6" fill="#1e40af"/>
  
  <!-- Cement bag icon -->
  <g transform="translate(8, 8)">
    <!-- Bag shape -->
    <path d="M2 2 L2 10 Q2 11 3 11 L13 11 Q14 11 14 10 L14 2 Q14 1 13 1 L3 1 Q2 1 2 2 Z" 
          fill="#fbbf24" stroke="#f59e0b" stroke-width="0.5"/>
    <!-- Bag top -->
    <rect x="1.5" y="0.5" width="13" height="1.5" rx="0.5" fill="#f59e0b"/>
    <!-- SOL text -->
    <text x="8" y="7" font-family="Arial, sans-serif" font-size="3" font-weight="bold" 
          text-anchor="middle" fill="#1e40af">SOL</text>
  </g>
</svg>
